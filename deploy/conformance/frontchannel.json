{
  "alias": "saffui",
  "description": "saffui, basic OP profile",
  "server": {
    "discoveryUrl": "https://saffui.test/realms/main/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "conformance-frontchannel",
    "client_secret": "a-conformance-client-secret-of-thirty-two-bytes-or-more"
  },
  "browser": [
    {
      "match": "https://saffui.test/realms/main/protocol/openid-connect/auth*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "https://saffui.test/realms/main/protocol/openid-connect/login*",
          "commands": [
            [
              "wait",
              "xpath",
              "//*",
              10,
              ".*Sign in.*",
              "update-image-placeholder-optional"
            ],
            [
              "text",
              "name",
              "username",
              "ada",
              "optional"
            ],
            [
              "text",
              "name",
              "password",
              "a-password-of-decent-length",
              "optional"
            ],
            [
              "click",
              "css",
              "button[type=submit]"
            ]
          ]
        },
        {
          "task": "Refused where it stands",
          "optional": true,
          "match": "https://saffui.test/realms/main/protocol/openid-connect/auth*",
          "commands": [
            [
              "wait",
              "xpath",
              "//*",
              10,
              ".*could not start.*",
              "update-image-placeholder"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "https://localhost.emobix.co.uk:8443/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ],
          "optional": true
        }
      ]
    },
    {
      "match": "https://saffui.test/realms/main/protocol/openid-connect/logout*",
      "tasks": [
        {
          "task": "Asked, or told",
          "optional": true,
          "match": "https://saffui.test/realms/main/protocol/openid-connect/logout*",
          "commands": [
            [
              "wait",
              "xpath",
              "//*",
              10,
              ".*(Sign out\\?|signed out).*"
            ],
            [
              "click",
              "xpath",
              "//button[@type='submit']",
              "optional"
            ]
          ]
        },
        {
          "task": "Told it is over",
          "optional": true,
          "match": "https://saffui.test/realms/main/protocol/openid-connect/logout*",
          "commands": [
            [
              "wait",
              "xpath",
              "//*",
              10,
              ".*signed out.*",
              "update-image-placeholder-optional"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "optional": true,
          "match": "https://localhost.emobix.co.uk:8443/test/*/post_logout_redirect*",
          "commands": [
            [
              "wait",
              "contains",
              "/post_logout_redirect",
              10
            ]
          ]
        }
      ]
    }
  ]
}
